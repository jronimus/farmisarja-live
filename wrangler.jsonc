{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "farmisarja-fpl-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FPL_LEAGUE_ID": "200068",
    "ALLOWED_ORIGIN": "https://jronimus.github.io",
    "PUBLIC_SITE_URL": "https://jronimus.github.io/farmisarja-live/",
    "TELEGRAM_CHAT_ID": "-1001048034441",
    "TELEGRAM_NOTIFICATIONS_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "TELEGRAM_STATE",
      "id": "565ce503e0d041278d22d2d88c0527b8"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
